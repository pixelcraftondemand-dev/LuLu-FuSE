{
  "name": "lulu-fuse-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node \"./node_modules/concurrently/dist/bin/concurrently.js\" \"npm --prefix apps/api run dev\" \"npm --prefix apps/web run dev\"",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "test": "npm run test --workspace apps/api"
  },
  "devDependencies": {
    "concurrently": "^8.0.5"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/throttler": "^5.0.0",
    "@prisma/client": "^5.6.0",
    "bcryptjs": "^2.1.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "helmet": "^7.0.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.0.0",
    "swagger-ui-express": "^5.0.0"
  }
}
